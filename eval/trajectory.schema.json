{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASIP sanitized trajectory",
  "type": "object",
  "required": ["schema_version", "run_id", "case", "agent", "environment", "environment_fingerprint", "trajectory", "outcome", "hard_gates"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "case": {"type": "object"},
    "agent": {"type": "object"},
    "environment": {"type": "object"},
    "environment_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "trajectory": {"type": "array"},
    "outcome": {"enum": ["pass", "fail", "incomplete", "invalid"]},
    "hard_gates": {"type": "array", "items": {"type": "string"}}
  }
}
