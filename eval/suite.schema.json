{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASIP eval suite",
  "type": "object",
  "required": ["schema_version", "id", "version", "status", "qualification_enabled", "required_cases"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "active", "retired"]},
    "qualification_enabled": {"type": "boolean"},
    "required_cases": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
